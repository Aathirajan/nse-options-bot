# =============================================================================
# .env.example — Environment variable template
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env — it is gitignored.
# =============================================================================

# INDstocks API token (get from https://indstocks.com/account)
INDSTOCKS_ACCESS_TOKEN=your-indstocks-token-here

# TrueData credentials (optional — only if pulling historical tick data)
TRUEDATA_USERNAME=your-truedata-username
TRUEDATA_PASSWORD=your-truedata-password
